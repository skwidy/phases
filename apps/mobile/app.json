{
  "expo": {
    "name": "Phases",
    "slug": "phases",
    "scheme": "phases",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "io.tryphases.app",
      "supportsTablet": false,
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Phases uses the camera only to scan a sync QR code.",
        "NSFaceIDUsageDescription": "Phases uses Face ID to lock the app.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": []
      }
    },
    "locales": {
      "fr": "./src/i18n/infoplist-fr.json",
      "en": "./src/i18n/infoplist-en.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#FBF3EA",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#17110E"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#231A17"
        }
      ],
      "expo-sqlite",
      "expo-localization",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Phases uses the camera only to scan a sync QR code.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Phases uses Face ID to lock the app."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
